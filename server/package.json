{
  "name": "dirty-apple-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "inventory:import": "node --import tsx src/inventory/import-cli.ts",
    "test:integration": "RUN_MONGO_TESTS=1 tsx --test src/__tests__/database.test.ts src/__tests__/inventory.integration.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "robots-parser": "^3.0.1",
    "stripe": "^14.25.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
