# See server/.env.example and frontend/.env.example for service-specific settings.
# Never put ADMIN_API_TOKEN, MONGODB_URI or Stripe secret keys in NEXT_PUBLIC variables.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dirty-apple
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ADMIN_API_TOKEN=
SCRAPE_WORKER_ENABLED=true
CRON_SECRET=
INVENTORY_CRON_ENABLED=false
OFFER_MAX_AGE_HOURS=24
DIRECT_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
