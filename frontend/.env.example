# Server-only origin for the same-origin API proxy (set the real HTTPS origin in production).
API_URL=http://localhost:4000
# Optional: explicitly opt into direct browser-to-API requests instead of the proxy.
NEXT_PUBLIC_API_URL=
# Required only for direct Dirty Apple checkout, when explicitly enabled on the backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional real support address; leave blank until configured.
NEXT_PUBLIC_SUPPORT_EMAIL=
